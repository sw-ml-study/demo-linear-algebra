# Fixed-fixture SVG evidence for LA07. Rendering is infrastructure.
# loops: 0

def u:matrix_basis_svg() { "Render a square grid before and after the LA07 matrix maps its basis columns.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 920 460\" width=\"920\" height=\"460\" role=\"img\"><title>A matrix transforms basis directions and their grid</title><desc>The identity square grid becomes a slanted grid. Blue e1 maps to the first matrix column [2,1], green e2 maps to the second column [1,2], and their sum reaches [3,3].</desc><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#c0caf5\"/></marker></defs><style>text{font-family:monospace;fill:#c0caf5}.panel{fill:#24283b;stroke:#414868;stroke-width:2}.grid{fill:none;stroke:#565f89;stroke-width:2}.mapped{stroke:#e0af68}.v{fill:none;stroke-width:5;marker-end:url(#a)}.one{stroke:#7aa2f7}.two{stroke:#9ece6a}.sum{fill:#f7768e}</style><rect width=\"920\" height=\"460\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">W=[[2,1],[1,2]]: columns are W e1 and W e2</text><rect class=\"panel\" x=\"25\" y=\"55\" width=\"410\" height=\"350\" rx=\"14\"/><rect class=\"panel\" x=\"485\" y=\"55\" width=\"410\" height=\"350\" rx=\"14\"/><text x=\"45\" y=\"88\">INPUT BASIS GRID</text><path class=\"grid\" d=\"M85 355H385M85 295H385M85 235H385M85 175H385M85 115H385M115 385V85M175 385V85M235 385V85M295 385V85M355 385V85\"/><path class=\"v one\" d=\"M175 295L295 295\"/><path class=\"v two\" d=\"M175 295L175 175\"/><text x=\"275\" y=\"325\">e1</text><text x=\"135\" y=\"180\">e2</text><text x=\"505\" y=\"88\">TRANSFORMED GRID</text><path class=\"grid mapped\" d=\"M515 355L815 205M545 385L845 235M575 415L875 265M515 295L665 370M575 175L875 325M515 235L815 385\"/><path class=\"v one\" d=\"M575 325L755 235\"/><path class=\"v two\" d=\"M575 325L665 145\"/><circle class=\"sum\" cx=\"845\" cy=\"55\" r=\"8\"/><text x=\"720\" y=\"250\">W e1=[2,1]</text><text x=\"600\" y=\"135\">W e2=[1,2]</text><text x=\"620\" y=\"435\">W(e1+e2)=[3,3]=W e1+W e2</text></svg>"
}
