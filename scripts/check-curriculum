#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tab=$(printf '\t')
lesson_count=0
while IFS="$tab" read -r id title status cli web; do
  [ "$id" = id ] && continue
  case "$id" in LA0[1-9]|LA1[0-5]) ;; *) continue;; esac
  lesson_count=$((lesson_count + 1))
  [ "$status" = runnable ] || { echo "$id is not runnable" >&2; exit 1; }
  [ -f "$repo_root/$cli" ] || { echo "$id missing CLI path: $cli" >&2; exit 1; }
  [ -f "$repo_root/$web" ] || { echo "$id missing web path: $web" >&2; exit 1; }
  for phrase in 'WHAT THIS SHOWS' 'PREREQUISITES' 'SHAPES' 'HOW TO READ THE RESULT' 'THE POINT'; do
    grep -q "$phrase" "$repo_root/$cli" || { echo "$id CLI missing $phrase" >&2; exit 1; }
  done
  grep -q 'ok({' "$repo_root/$cli" || { echo "$id CLI is not self-checking" >&2; exit 1; }
  grep -q 'err(' "$repo_root/$cli" || { echo "$id CLI has no failing invariant" >&2; exit 1; }
  for phrase in 'WHAT THIS SHOWS' 'PREREQUISITES' 'SHAPES' 'EXECUTABLE CLAIM' 'NUMERICAL CONTRACT' 'BOUNDARY' 'HOW TO READ THE RESULT' 'THE POINT'; do
    grep -q "$phrase" "$repo_root/$web" || { echo "$id web lesson missing $phrase" >&2; exit 1; }
  done
  grep -q 'visual = u:' "$repo_root/$web" || { echo "$id web lesson does not bind its visual" >&2; exit 1; }
  generated="$repo_root/web/$(basename "$web")"
  [ -f "$generated" ] || { echo "$id generated web copy missing" >&2; exit 1; }
  cmp "$repo_root/$web" "$generated" || { echo "$id generated web copy is stale" >&2; exit 1; }
done < "$repo_root/catalog/lessons.tsv"
[ "$lesson_count" -eq 15 ] || { echo "expected fifteen runnable lessons through LA15, found $lesson_count" >&2; exit 1; }

if find "$repo_root/demos/web" -type f -name '*.mlpl' -exec grep -lE 'include "|write_text\(|read_text\(' {} \; | grep .; then
  echo "authored web lessons must be standalone and effect-free" >&2
  exit 1
fi

for preview in "$repo_root"/assets/previews/LA*.svg; do
  grep -q '<title>' "$preview" || { echo "preview lacks title: $preview" >&2; exit 1; }
  grep -q '<desc>' "$preview" || { echo "preview lacks description: $preview" >&2; exit 1; }
  if grep -qE '<animate|@keyframes' "$preview"; then
    grep -q 'prefers-reduced-motion' "$preview" || { echo "animated preview lacks reduced-motion fallback: $preview" >&2; exit 1; }
  fi
done

grep -q 'just-outside value accepted' "$repo_root/tests/test_norm_distance.mlpl"
grep -q 'MLPL v0.20.0' "$repo_root/docs/capability-baseline.md"
grep -q 'index has 3 components but array has rank 2' "$repo_root/docs/sw-mlpl-blockers.md"
grep -q 'unknown function: solve' "$repo_root/docs/sw-mlpl-blockers.md"
grep -q 'B2 — stable general linear solve with diagnostics (verified blocker)' "$repo_root/docs/sw-mlpl-blockers.md"
grep -q 'multiple right-hand sides' "$repo_root/docs/stable-solve-blocker-decision.md"
grep -q '^LA06.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA07.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA08.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA09.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA10.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA11.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA12.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA13.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA14.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA15.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA16.*blocked' "$repo_root/catalog/lessons.tsv"
grep -q 'W\*0=0' "$repo_root/docs/syllabus.md"
grep -q 'shared `inner` dimension is consumed' "$repo_root/docs/syllabus.md"
grep -q '(AB)^T=B^T A^T' "$repo_root/docs/syllabus.md"
grep -q 'does not claim a general determinant' "$repo_root/docs/syllabus.md"
grep -q '50 tests' "$repo_root/docs/matrix-acceptance.md"
grep -q 'B1 remains verified' "$repo_root/docs/matrix-acceptance.md"
grep -q 'Reconciled executable plan: `docs/systems-saga.md`' "$repo_root/docs/sagas.md"
grep -q '|det|<=1e-9' "$repo_root/docs/syllabus.md"
grep -q 'production-grade general elimination' "$repo_root/docs/syllabus.md"
grep -q 'does not certify accurate parameters' "$repo_root/docs/syllabus.md"
grep -q '15 capability probes' "$repo_root/docs/systems-acceptance.md"
grep -q 'B2 is verified' "$repo_root/docs/systems-acceptance.md"
grep -q 'Reconciled executable plan: `docs/factorizations-saga.md`' "$repo_root/docs/sagas.md"
grep -q 'four power steps' "$repo_root/docs/factorization-capability-baseline.md"
grep -q 'decision keeps B3 a candidate' "$repo_root/docs/factorization-capability-baseline.md"
grep -q 'teaching code, not stable general QR' "$repo_root/docs/syllabus.md"
grep -q 'reconstruction alone does not certify' "$repo_root/docs/syllabus.md"
grep -q '90-degree rotation reaches its limit' "$repo_root/docs/syllabus.md"
grep -q 'do not promote B3' "$repo_root/docs/decomposition-blocker-decision.md"
grep -q 'no speculative failure probe is added' "$repo_root/docs/decomposition-blocker-decision.md"
grep -q 'unknown function: svd' "$repo_root/docs/svd-blocker-decision.md"
grep -q 'SVD and low-rank approximation \*\*(blocked by B3)\*\*' "$repo_root/docs/syllabus.md"
echo "curriculum: fifteen lessons integrated through LA15"
