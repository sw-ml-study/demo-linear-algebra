# Fixed-fixture SVG evidence for LA11. Rendering is infrastructure.
# loops: 0

def u:systems2_svg() { "Render unique, parallel-inconsistent, and coincident 2D equation pairs.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 440\" width=\"960\" height=\"440\" role=\"img\"><title>Three outcomes for two linear equations in two unknowns</title><desc>Two blue and green lines cross at one pink point for a unique solution, remain parallel for no solution, or overlap for infinitely many solutions.</desc><style>text{font-family:monospace;fill:#c0caf5}.p{fill:#24283b;stroke:#414868;stroke-width:2}.axis{stroke:#565f89}.one{stroke:#7aa2f7;stroke-width:4}.two{stroke:#9ece6a;stroke-width:4}.dash{stroke-dasharray:10 7}.hit{fill:#f7768e}.gold{fill:#e0af68}</style><rect width=\"960\" height=\"440\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">A:[equation=2,unknown=2] x:[unknown=2] = b:[equation=2]</text><rect class=\"p\" x=\"20\" y=\"60\" width=\"290\" height=\"320\" rx=\"14\"/><text x=\"40\" y=\"92\">UNIQUE: det != 0</text><path class=\"axis\" d=\"M45 330H285M80 355V110\"/><path class=\"one\" d=\"M45 310L275 125\"/><path class=\"two\" d=\"M50 130L280 325\"/><circle class=\"hit\" cx=\"163\" cy=\"215\" r=\"8\"/><text x=\"163\" y=\"355\" text-anchor=\"middle\">x=[1,1], residual=0</text><rect class=\"p\" x=\"335\" y=\"60\" width=\"290\" height=\"320\" rx=\"14\"/><text x=\"355\" y=\"92\">INCONSISTENT: parallel</text><path class=\"axis\" d=\"M360 330H600M395 355V110\"/><path class=\"one\" d=\"M365 300L590 145\"/><path class=\"two\" d=\"M365 245L590 90\"/><text class=\"gold\" x=\"480\" y=\"355\" text-anchor=\"middle\">det=0, augmented cross != 0</text><rect class=\"p\" x=\"650\" y=\"60\" width=\"290\" height=\"320\" rx=\"14\"/><text x=\"670\" y=\"92\">UNDERDETERMINED: same line</text><path class=\"axis\" d=\"M675 330H915M710 355V110\"/><path class=\"one\" d=\"M680 300L905 145\"/><path class=\"two dash\" d=\"M680 300L905 145\"/><circle class=\"hit\" cx=\"790\" cy=\"224\" r=\"7\"/><text x=\"795\" y=\"355\" text-anchor=\"middle\">one witness; infinitely many</text><text x=\"480\" y=\"415\" text-anchor=\"middle\">determinant classifies coefficient geometry; augmented targets separate overlap from inconsistency</text></svg>"
}
