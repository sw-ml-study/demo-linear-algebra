# Fixed-fixture SVG evidence for LA10. Rendering is infrastructure.
# loops: 0

def u:determinant_svg() { "Render positive, negative, and zero signed-area basis images.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 960 450\" width=\"960\" height=\"450\" role=\"img\"><title>Two-dimensional determinant measures signed area change</title><desc>A positive determinant two spans a blue parallelogram with preserved orientation, a negative determinant minus two spans a pink parallelogram with reversed orientation, and determinant zero collapses a grid onto one gold line.</desc><defs><marker id=\"a\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" fill=\"#c0caf5\"/></marker></defs><style>text{font-family:monospace;fill:#c0caf5}.p{fill:#24283b;stroke:#414868;stroke-width:2}.axis{stroke:#565f89}.pos{fill:#7aa2f755;stroke:#7aa2f7;stroke-width:3}.neg{fill:#f7768e55;stroke:#f7768e;stroke-width:3}.zero{stroke:#e0af68;stroke-width:5}.v{fill:none;stroke-width:4;marker-end:url(#a)}</style><rect width=\"960\" height=\"450\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">det([[a,b],[c,d]]) = ad-bc: signed area scale in 2D</text><rect class=\"p\" x=\"20\" y=\"60\" width=\"290\" height=\"330\" rx=\"14\"/><text x=\"40\" y=\"92\">det=+2: preserve</text><path class=\"axis\" d=\"M55 340H280M80 370V115\"/><path class=\"pos\" d=\"M80 340L230 290L270 170L120 220Z\"/><path class=\"v\" stroke=\"#7aa2f7\" d=\"M80 340L230 290\"/><path class=\"v\" stroke=\"#9ece6a\" d=\"M80 340L120 220\"/><text x=\"165\" y=\"375\">area x2, sign +</text><rect class=\"p\" x=\"335\" y=\"60\" width=\"290\" height=\"330\" rx=\"14\"/><text x=\"355\" y=\"92\">det=-2: reverse</text><path class=\"axis\" d=\"M370 340H595M395 370V115\"/><path class=\"neg\" d=\"M395 340L435 220L585 270L545 390Z\"/><path class=\"v\" stroke=\"#7aa2f7\" d=\"M395 340L435 220\"/><path class=\"v\" stroke=\"#f7768e\" d=\"M395 340L545 390\"/><text x=\"480\" y=\"375\">area x2, sign -</text><rect class=\"p\" x=\"650\" y=\"60\" width=\"290\" height=\"330\" rx=\"14\"/><text x=\"670\" y=\"92\">det=0: singular</text><path class=\"axis\" d=\"M685 340H910M710 370V115\"/><path class=\"zero\" d=\"M680 370L910 140\"/><path class=\"v\" stroke=\"#7aa2f7\" d=\"M710 340L800 250\"/><path class=\"v\" stroke=\"#9ece6a\" d=\"M710 340L890 160\"/><text x=\"795\" y=\"375\">plane collapses to line</text><text x=\"480\" y=\"425\" text-anchor=\"middle\">absolute determinant scales area; sign records orientation; zero loses one 2D direction</text></svg>"
}
