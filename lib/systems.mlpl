# Checked primitives for bounded systems, elimination, and residual lessons.
# loops: bounded by matrix width

include "matrices.mlpl";

def u:is_finite_numeric(value) { "Detect finite numeric arrays because NaN and infinity make value-value unequal to zero."; reduce_mul(eq(value - value, 0)) }
def u:matrix_set_cell(matrix, row_index, column_index, value) { "Update one checked rank-two cell through flat scatter and reshape.";
  dimensions = u:matrix_dimensions(matrix)?;
  if u:valid_matrix_index(row_index, dimensions.rows) * u:valid_matrix_index(column_index, dimensions.columns) { ok(reshape(scatter(flatten(matrix), row_index * dimensions.columns + column_index, value), [dimensions.rows, dimensions.columns])) } else { err({kind: "matrix_cell_index", row: row_index, column: column_index, shape: shape(matrix)}) }
}
def u:matrix_swap_rows(matrix, first_row, second_row) { "Swap two checked rows through bounded flat cell updates.";
  dimensions = u:matrix_dimensions(matrix)?;
  if u:valid_matrix_index(first_row, dimensions.rows) * u:valid_matrix_index(second_row, dimensions.rows) { original = flatten(matrix); changed = original; column = 0; while lt(column, dimensions.columns) { first_index = first_row * dimensions.columns + column; second_index = second_row * dimensions.columns + column; changed = scatter(scatter(changed, first_index, take(original, 0, second_index)), second_index, take(original, 0, first_index)); column = column + 1 }; ok(reshape(changed, [dimensions.rows, dimensions.columns])) } else { err({kind: "matrix_row_index", first: first_row, second: second_row, rows: dimensions.rows}) }
}
def u:system_residual(coefficients, candidate, targets) { "Compute Ax-b and its Euclidean norm independently from any solve path.";
  dimensions = u:matrix_dimensions(coefficients)?;
  if eq(rank(candidate), 1) * eq(rank(targets), 1) * eq(tally(candidate), dimensions.columns) * eq(tally(targets), dimensions.rows) { predicted = matmul(coefficients, candidate); residual = predicted - targets; ok({predicted: predicted, residual: residual, norm: sqrt(reduce_add(residual * residual))}) } else { err({kind: "system_shape", coefficients: shape(coefficients), candidate: shape(candidate), targets: shape(targets)}) }
}
def u:valid_system2(coefficients, targets, tolerance) { "Check the exact bounded 2-by-2 system shape, finite values, and finite nonnegative tolerance.";
  equal(shape(coefficients), [2, 2]) * equal(shape(targets), [2]) * u:is_finite_numeric(coefficients) * u:is_finite_numeric(targets) * u:is_finite_numeric(tolerance) * (1 - lt(tolerance, 0))
}
def u:solve_system2(coefficients, targets, tolerance) { "Classify and solve only a finite 2-by-2 system using determinant cross-products and an explicit tolerance.";
  if 1 - u:valid_system2(coefficients, targets, tolerance) { err({kind: "system2_contract", coefficients: shape(coefficients), targets: shape(targets), tolerance: tolerance}) } else {
    a = u:matrix_cell(coefficients, 0, 0)?; b = u:matrix_cell(coefficients, 0, 1)?; c = u:matrix_cell(coefficients, 1, 0)?; d = u:matrix_cell(coefficients, 1, 1)?; e = take(targets, 0, 0); f = take(targets, 0, 1); determinant = a * d - b * c;
    if gt(abs(determinant), tolerance) { candidate = [(e * d - b * f) / determinant, (a * f - e * c) / determinant]; measured = u:system_residual(coefficients, candidate, targets)?; ok({kind: "unique", determinant: determinant, candidate: candidate, residual: measured.residual, residual_norm: measured.norm}) } else {
      first_augmented = a * f - c * e; second_augmented = b * f - d * e; zero_coefficients = (1 - gt(abs(a), tolerance)) * (1 - gt(abs(b), tolerance)) * (1 - gt(abs(c), tolerance)) * (1 - gt(abs(d), tolerance)); nonzero_target = gt(abs(e), tolerance) + gt(abs(f), tolerance);
      if gt(abs(first_augmented), tolerance) + gt(abs(second_augmented), tolerance) + zero_coefficients * nonzero_target { ok({kind: "parallel_inconsistent", determinant: determinant, first_augmented: first_augmented, second_augmented: second_augmented}) } else {
        witness = if gt(abs(a), tolerance) { [e / a, 0] } else { if gt(abs(b), tolerance) { [0, e / b] } else { if gt(abs(c), tolerance) { [f / c, 0] } else { if gt(abs(d), tolerance) { [0, f / d] } else { [0, 0] } } } }; measured = u:system_residual(coefficients, witness, targets)?; ok({kind: "coincident_underdetermined", determinant: determinant, witness: witness, residual: measured.residual, residual_norm: measured.norm})
      }
    }
  }
}
def u:eliminate_system2(coefficients, targets, tolerance) { "Trace Gaussian elimination for exactly two equations and two unknowns, with guarded pivots and rank classification.";
  if 1 - u:valid_system2(coefficients, targets, tolerance) { err({kind: "elimination2_contract", coefficients: shape(coefficients), targets: shape(targets), tolerance: tolerance, maximum: [2, 2]}) } else {
    a = u:matrix_cell(coefficients, 0, 0)?; b = u:matrix_cell(coefficients, 0, 1)?; c = u:matrix_cell(coefficients, 1, 0)?; d = u:matrix_cell(coefficients, 1, 1)?; e = take(targets, 0, 0); f = take(targets, 0, 1); initial = [[a, b, e], [c, d, f]];
    swapped = (1 - gt(abs(a), tolerance)) * gt(abs(c), tolerance); pivoted = if swapped { [[c, d, f], [a, b, e]] } else { initial }; p = u:matrix_cell(pivoted, 0, 0)?; q = u:matrix_cell(pivoted, 0, 1)?; r = u:matrix_cell(pivoted, 0, 2)?; s = u:matrix_cell(pivoted, 1, 0)?; t = u:matrix_cell(pivoted, 1, 1)?; u = u:matrix_cell(pivoted, 1, 2)?;
    multiplier = if gt(abs(p), tolerance) { s / p } else { 0 }; echelon = if gt(abs(p), tolerance) { [[p, q, r], [0, t - multiplier * q, u - multiplier * r]] } else { pivoted }; second_pivot = u:matrix_cell(echelon, 1, 1)?; second_target = u:matrix_cell(echelon, 1, 2)?; classified = u:solve_system2(coefficients, targets, tolerance)?;
    if equal(classified.kind, "unique") { y = second_target / second_pivot; x = (r - q * y) / p; candidate = [x, y]; measured = u:system_residual(coefficients, candidate, targets)?; ok({kind: "unique", initial: initial, swapped: swapped, pivoted: pivoted, multiplier: multiplier, echelon: echelon, rref: [[1, 0, x], [0, 1, y]], coefficient_rank: 2, augmented_rank: 2, candidate: candidate, residual_norm: measured.norm, maximum: [2, 2]}) } else {
      coefficient_nonzero = gt(reduce_add(abs(flatten(coefficients))), tolerance); coefficient_rank = if coefficient_nonzero { 1 } else { 0 }; augmented_rank = if equal(classified.kind, "parallel_inconsistent") { coefficient_rank + 1 } else { coefficient_rank }; ok({kind: classified.kind, initial: initial, swapped: swapped, pivoted: pivoted, multiplier: multiplier, echelon: echelon, coefficient_rank: coefficient_rank, augmented_rank: augmented_rank, maximum: [2, 2]})
    }
  }
}
