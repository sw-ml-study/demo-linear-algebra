# Fixed-fixture SVG evidence for LA08. Rendering is infrastructure.
# loops: 0

def u:matmul_accumulator_svg() { "Render one active row-column dot and all four derived product cells.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 940 470\" width=\"940\" height=\"470\" role=\"img\"><title>Matrix multiplication is a grid of row-column dot products</title><desc>The second row of A and first column of B are highlighted. Their products 3 times 5 and 4 times 7 accumulate to output cell 43, alongside the other three derived cells.</desc><style>text{font-family:monospace;fill:#c0caf5}.p{fill:#24283b;stroke:#414868;stroke-width:2}.cell{fill:#1a1b26;stroke:#565f89;stroke-width:2}.row{fill:#7aa2f7}.col{fill:#9ece6a}.active{fill:#f7768e}.gold{fill:#e0af68;font-size:21px}.arrow{stroke:#e0af68;stroke-width:4;fill:none}</style><rect width=\"940\" height=\"470\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">A:[2,2] @ B:[2,2] - each output cell is one row dot one column</text><rect class=\"p\" x=\"25\" y=\"60\" width=\"270\" height=\"190\" rx=\"14\"/><text x=\"45\" y=\"92\">A rows</text><rect class=\"cell\" x=\"55\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"cell\" x=\"150\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"row\" x=\"55\" y=\"175\" width=\"90\" height=\"50\"/><rect class=\"row\" x=\"150\" y=\"175\" width=\"90\" height=\"50\"/><text x=\"96\" y=\"147\">1</text><text x=\"191\" y=\"147\">2</text><text x=\"96\" y=\"207\">3</text><text x=\"191\" y=\"207\">4</text><rect class=\"p\" x=\"325\" y=\"60\" width=\"270\" height=\"190\" rx=\"14\"/><text x=\"345\" y=\"92\">B columns</text><rect class=\"col\" x=\"355\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"cell\" x=\"450\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"col\" x=\"355\" y=\"175\" width=\"90\" height=\"50\"/><rect class=\"cell\" x=\"450\" y=\"175\" width=\"90\" height=\"50\"/><text x=\"396\" y=\"147\">5</text><text x=\"491\" y=\"147\">6</text><text x=\"396\" y=\"207\">7</text><text x=\"491\" y=\"207\">8</text><rect class=\"p\" x=\"625\" y=\"60\" width=\"290\" height=\"190\" rx=\"14\"/><text x=\"645\" y=\"92\">C=A @ B</text><rect class=\"cell\" x=\"660\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"cell\" x=\"755\" y=\"115\" width=\"90\" height=\"50\"/><rect class=\"active\" x=\"660\" y=\"175\" width=\"90\" height=\"50\"/><rect class=\"cell\" x=\"755\" y=\"175\" width=\"90\" height=\"50\"/><text x=\"695\" y=\"147\">19</text><text x=\"790\" y=\"147\">22</text><text x=\"695\" y=\"207\">43</text><text x=\"790\" y=\"207\">50</text><path class=\"arrow\" d=\"M180 280H760\"/><text class=\"gold\" x=\"470\" y=\"315\" text-anchor=\"middle\">active C[1,0]: row [3,4] dot column [5,7]</text><rect class=\"p\" x=\"130\" y=\"340\" width=\"680\" height=\"95\" rx=\"14\"/><text x=\"205\" y=\"380\" font-size=\"22\">3 * 5</text><text class=\"gold\" x=\"350\" y=\"380\">+</text><text x=\"410\" y=\"380\" font-size=\"22\">4 * 7</text><text class=\"gold\" x=\"555\" y=\"380\">=</text><text class=\"gold\" x=\"625\" y=\"380\">15 + 28 = 43</text><text x=\"470\" y=\"415\" text-anchor=\"middle\">inner dimension 2 is consumed; output keeps A rows x B columns</text></svg>"
}
