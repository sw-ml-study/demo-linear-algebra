#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test -f "$repo_root/mlplunit.conf"
test -f "$repo_root/catalog/probes.tsv"
test -f "$repo_root/catalog/lessons.tsv"
test -f "$repo_root/catalog/ml-payoffs.tsv"
test -f "$repo_root/catalog/matrix-contract.tsv"
test -f "$repo_root/docs/plan.md"
test -f "$repo_root/docs/syllabus.md"
test -f "$repo_root/docs/sw-mlpl-blockers.md"
test -f "$repo_root/docs/capability-baseline.md"
test -f "$repo_root/docs/matrix-capability-baseline.md"
test -f "$repo_root/docs/matrix-acceptance.md"
test -f "$repo_root/docs/systems-saga.md"
test -f "$repo_root/docs/systems-capability-baseline.md"
test -f "$repo_root/docs/systems-acceptance.md"
test -f "$repo_root/docs/factorizations-saga.md"
test -f "$repo_root/docs/factorization-capability-baseline.md"
test -f "$repo_root/docs/decomposition-blocker-decision.md"
test -f "$repo_root/docs/svd-blocker-decision.md"
test -f "$repo_root/docs/factorization-acceptance.md"
test -f "$repo_root/docs/ml-payoff-saga.md"
test -f "$repo_root/docs/ml-payoff-capability-baseline.md"
test -f "$repo_root/docs/la17-least-squares-gate.md"
test -f "$repo_root/docs/la18-pca-gate.md"
test -f "$repo_root/docs/ml-payoff-integration.md"
test -f "$repo_root/docs/ml-payoff-acceptance.md"
test -f "$repo_root/docs/curriculum-closeout-saga.md"
test -f "$repo_root/docs/web-lesson-template.mlpl"
test -f "$repo_root/web/START_HERE.md"
cmp "$repo_root/docs/syllabus.md" "$repo_root/web/START_HERE.md"
grep -q 'WHAT THIS SHOWS' "$repo_root/docs/web-lesson-template.mlpl"
grep -q 'HOW TO READ THE RESULT' "$repo_root/docs/web-lesson-template.mlpl"
grep -q 'THE POINT' "$repo_root/docs/web-lesson-template.mlpl"
if find "$repo_root/web" -type f -name '*.mlpl' -exec grep -l 'include "' {} \; | grep .; then
  echo "web demos must be standalone" >&2
  exit 1
fi
for lesson in "$repo_root"/web/*.mlpl; do
  [ -f "$lesson" ] || continue
  grep -q 'WHAT THIS SHOWS' "$lesson"
  grep -q 'HOW TO READ THE RESULT' "$lesson"
  grep -q 'THE POINT' "$lesson"
done
grep -q '^LA07.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA08.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA09.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA10.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA11.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA12.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA13.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA14.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA15.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA16.*blocked' "$repo_root/catalog/lessons.tsv"
grep -q '^LA17.*blocked' "$repo_root/catalog/lessons.tsv"
grep -q '^LA18.*blocked' "$repo_root/catalog/lessons.tsv"
grep -q '^LA19.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q '^LA20.*runnable' "$repo_root/catalog/lessons.tsv"
grep -q 'XW+b' "$repo_root/demos/00-matrix-payoff/dense_layer.mlpl"
echo "structure: ok"
