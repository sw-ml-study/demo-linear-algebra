# Fixed-fixture SVG evidence for LA13. Rendering is infrastructure.
# loops: 0

def u:conditioning_svg() { "Contrast well-conditioned and near-singular perturbations, then residual and solution error.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 470\" width=\"980\" height=\"470\" role=\"img\"><title>Conditioning separates residual size from solution accuracy</title><desc>An identity system maps a tiny target perturbation to the same tiny solution change. A near-singular system amplifies the same target change into a large solution change. A final comparison shows tiny residual beside large solution error.</desc><style>text{font-family:monospace;fill:#c0caf5}.p{fill:#24283b;stroke:#414868;stroke-width:2}.axis{stroke:#565f89}.input{fill:#7aa2f7}.good{fill:#9ece6a}.bad{fill:#f7768e}.gold{fill:#e0af68}.label{font-size:16px}</style><rect width=\"980\" height=\"470\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">same target delta 1e-6; radically different solution response</text><rect class=\"p\" x=\"20\" y=\"60\" width=\"450\" height=\"245\" rx=\"14\"/><text x=\"40\" y=\"92\">WELL-CONDITIONED: I x = b</text><text x=\"50\" y=\"130\">target delta</text><rect class=\"input\" x=\"190\" y=\"112\" width=\"35\" height=\"22\"/><text x=\"235\" y=\"130\">1e-6</text><text x=\"50\" y=\"180\">solution delta</text><rect class=\"good\" x=\"190\" y=\"162\" width=\"35\" height=\"22\"/><text x=\"235\" y=\"180\">1e-6</text><text class=\"good\" x=\"245\" y=\"240\" text-anchor=\"middle\">amplification = 1</text><text x=\"245\" y=\"278\" text-anchor=\"middle\">nearby targets → nearby solutions</text><rect class=\"p\" x=\"510\" y=\"60\" width=\"450\" height=\"245\" rx=\"14\"/><text x=\"530\" y=\"92\">NEAR-SINGULAR: rows almost parallel</text><text x=\"540\" y=\"130\">target delta</text><rect class=\"input\" x=\"680\" y=\"112\" width=\"2\" height=\"22\"/><text x=\"695\" y=\"130\">1e-6</text><text x=\"540\" y=\"180\">solution delta</text><rect class=\"bad\" x=\"680\" y=\"162\" width=\"210\" height=\"22\"/><text x=\"900\" y=\"180\">sqrt(2)</text><text class=\"bad\" x=\"735\" y=\"240\" text-anchor=\"middle\">amplification ≈ 1.414e6</text><text x=\"735\" y=\"278\" text-anchor=\"middle\">tiny target change → order-one solution change</text><rect class=\"p\" x=\"20\" y=\"335\" width=\"940\" height=\"95\" rx=\"14\"/><text x=\"45\" y=\"370\">wrong candidate [2,0] for true [1,1]:</text><text class=\"gold\" x=\"430\" y=\"370\">residual ≈ 1e-6</text><text class=\"bad\" x=\"680\" y=\"370\">solution error = sqrt(2)</text><text x=\"490\" y=\"410\" text-anchor=\"middle\">small residual says equations are nearly satisfied; it does not certify parameter accuracy</text><text x=\"490\" y=\"458\" text-anchor=\"middle\">absolute amplification is fixture-specific, not a general condition-number implementation</text></svg>"
}
