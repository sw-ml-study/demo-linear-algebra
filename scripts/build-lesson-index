#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
destination=${1:-"$repo_root/docs/capability-lesson-index.md"}
temporary=$(mktemp "${TMPDIR:-/tmp}/lesson-index.XXXXXX")
trap 'rm -f "$temporary"' EXIT
awk -F '\t' '
  function ref(path) { return path == "-" ? "—" : "[`" path "`](../" path ")" }
  NR==FNR { if ($1 != "id") { prereq[$1]=$2; test[$1]=$3; preview[$1]=$4; blocker[$1]=$5 } next }
  BEGIN { print "# Generated capability and lesson index"; print ""; print "Generated by `scripts/build-lesson-index` from `catalog/lessons.tsv` and `catalog/lesson-evidence.tsv`. Do not edit this file directly."; print ""; print "| ID | Lesson | Status | Prerequisites | CLI | Web | Test | Preview | Blocker probe |"; print "|---|---|---|---|---|---|---|---|---|" }
  $1 != "id" { print "| " $1 " | " $2 " | **" $3 "** | " prereq[$1] " | " ref($4) " | " ref($5) " | " ref(test[$1]) " | " ref(preview[$1]) " | " (blocker[$1] == "-" ? "—" : "`" blocker[$1] "`") " |"; seen++ }
  END { print ""; print "Summary: **" seen " lessons**, with runnable artifacts linked directly and constrained leaves linked to their configured blocker probes." }
' "$repo_root/catalog/lesson-evidence.tsv" "$repo_root/catalog/lessons.tsv" > "$temporary"
mv "$temporary" "$destination"
trap - EXIT
echo "lesson index written: ${destination#$repo_root/}"
