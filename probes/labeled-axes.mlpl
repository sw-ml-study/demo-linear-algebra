# Probe: labels survive compatible matrix multiplication.
a : [sample, feature] = reshape(range(6) + 1, [2, 3])
b : [feature, output] = reshape(range(6) + 1, [3, 2])
c = matmul(a, b)
if equal(shape(c), [2, 2]) * equal(labels(c), "sample,output") {
  ok({probe: "labeled-axes", shape: shape(c), labels: labels(c)})
} else { err("matmul label propagation changed") }
