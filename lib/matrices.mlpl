# Pure rank-2 matrix anatomy and checked extraction helpers.
# loops: 0

def u:is_matrix(value) { "Return one exactly when value has rank two."; eq(rank(value), 2) }
def u:matrix_dimensions(matrix) { "Return named row and column counts for a rank-two matrix.";
  if u:is_matrix(matrix) { dimensions = shape(matrix); ok({rows: take(dimensions, 0, 0), columns: take(dimensions, 0, 1)}) } else { err({kind: "matrix_rank", actual: rank(matrix), expected: 2}) }
}
def u:valid_matrix_index(index, upper_bound) { "Require a finite zero-based integer strictly below one dimension.";
  (1 - lt(index, 0)) * lt(index, upper_bound) * eq(index, floor(index))
}
def u:matrix_row(matrix, row_index) { "Extract one row while preserving the remaining column-axis label.";
  dimensions = u:matrix_dimensions(matrix)?;
  if u:valid_matrix_index(row_index, dimensions.rows) { ok(take(matrix, 0, row_index)) } else { err({kind: "row_index", index: row_index, rows: dimensions.rows}) }
}
def u:matrix_column(matrix, column_index) { "Extract one column while preserving the remaining row-axis label.";
  dimensions = u:matrix_dimensions(matrix)?;
  if u:valid_matrix_index(column_index, dimensions.columns) { ok(take(matrix, 1, column_index)) } else { err({kind: "column_index", columns: dimensions.columns, index: column_index}) }
}
def u:matrix_cell(matrix, row_index, column_index) { "Extract one scalar cell after validating both matrix coordinates.";
  row = u:matrix_row(matrix, row_index)?;
  dimensions = u:matrix_dimensions(matrix)?;
  if u:valid_matrix_index(column_index, dimensions.columns) { ok(take(row, 0, column_index)) } else { err({kind: "column_index", columns: dimensions.columns, index: column_index}) }
}
def u:matrix_transform(matrix, vector) { "Apply a rank-two matrix [output,input] to one rank-one [input] vector.";
  dimensions = u:matrix_dimensions(matrix)?;
  if 1 - eq(rank(vector), 1) { err({kind: "transform_vector_rank", actual: rank(vector), expected: 1}) } else { if eq(dimensions.columns, tally(vector)) { ok(matmul(matrix, vector)) } else { err({kind: "transform_shape", matrix: shape(matrix), vector: shape(vector), expected_input: dimensions.columns}) } }
}
def u:matrix_product_dimensions(left, right) { "Validate [rows,inner] times [inner,columns] and return the product dimensions.";
  left_dimensions = u:matrix_dimensions(left)?; right_dimensions = u:matrix_dimensions(right)?;
  if eq(left_dimensions.columns, right_dimensions.rows) { ok({rows: left_dimensions.rows, inner: left_dimensions.columns, columns: right_dimensions.columns}) } else { err({kind: "matmul_inner_dimension", left: shape(left), right: shape(right), left_inner: left_dimensions.columns, right_inner: right_dimensions.rows}) }
}
def u:matrix_product_cell(left, right, row_index, column_index) { "Expose one product cell as its active row, column, component products, and accumulated sum.";
  dimensions = u:matrix_product_dimensions(left, right)?;
  if u:valid_matrix_index(row_index, dimensions.rows) * u:valid_matrix_index(column_index, dimensions.columns) { row = u:matrix_row(left, row_index)?; column = u:matrix_column(right, column_index)?; products = row * column; ok({row: row, column: column, products: products, sum: reduce_add(products)}) } else { err({kind: "product_index", row: row_index, column: column_index, rows: dimensions.rows, columns: dimensions.columns}) }
}
def u:matrix_multiply_derived(left, right) { "Derive every rank-two product cell by a row-column dot rather than calling matmul.";
  dimensions = u:matrix_product_dimensions(left, right)?; cells = fill([dimensions.rows * dimensions.columns], 0); row = 0;
  while lt(row, dimensions.rows) { column = 0; while lt(column, dimensions.columns) { trace = u:matrix_product_cell(left, right, row, column)?; cells = scatter(cells, row * dimensions.columns + column, trace.sum); column = column + 1 }; row = row + 1 };
  ok(reshape(cells, [dimensions.rows, dimensions.columns]))
}
def u:matrix_determinant2(matrix) { "Compute ad-bc for exactly one 2-by-2 matrix; this is bounded curriculum code, not a general determinant.";
  dimensions = u:matrix_dimensions(matrix)?;
  if eq(dimensions.rows, 2) * eq(dimensions.columns, 2) { a = u:matrix_cell(matrix, 0, 0)?; b = u:matrix_cell(matrix, 0, 1)?; c = u:matrix_cell(matrix, 1, 0)?; d = u:matrix_cell(matrix, 1, 1)?; ok(a * d - b * c) } else { err({kind: "determinant2_shape", actual: shape(matrix), expected: [2, 2]}) }
}
def u:matrix_area_kind2(matrix) { "Classify a 2D transform as preserving or reversing orientation, or collapsing area.";
  determinant = u:matrix_determinant2(matrix)?;
  if gt(determinant, 0) { ok("orientation_preserved") } else { if lt(determinant, 0) { ok("orientation_reversed") } else { ok("singular_collapsed") } }
}
def u:dense_layer(inputs, weights, bias) { "Apply X:[sample,feature] @ W:[feature,output] plus one broadcast [output] bias.";
  dimensions = u:matrix_product_dimensions(inputs, weights)?;
  if 1 - eq(rank(bias), 1) { err({kind: "dense_bias_rank", actual: rank(bias), expected: 1}) } else { if eq(tally(bias), dimensions.columns) { bias_rows = matmul(ones([dimensions.rows, 1]), reshape(bias, [1, dimensions.columns])); ok(matmul(inputs, weights) + bias_rows) } else { err({kind: "dense_bias_shape", bias: shape(bias), expected_output: dimensions.columns}) } }
}
