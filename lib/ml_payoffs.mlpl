# Checked bounded mechanisms connecting linear algebra to ML payoffs.
include "systems.mlpl";

def u:bounded_lora(base, left_factor, right_factor, inputs) { "Construct and verify one rank-2 LoRA-style weight update without training claims.";
  base_dimensions = u:matrix_dimensions(base)?; left_dimensions = u:matrix_dimensions(left_factor)?; right_dimensions = u:matrix_dimensions(right_factor)?; input_dimensions = u:matrix_dimensions(inputs)?;
  compatible = eq(base_dimensions.rows, left_dimensions.rows) * eq(left_dimensions.columns, right_dimensions.rows) * eq(base_dimensions.columns, right_dimensions.columns) * eq(input_dimensions.columns, base_dimensions.rows);
  if 1 - compatible { err({kind: "lora_shape", base: shape(base), left_factor: shape(left_factor), right_factor: shape(right_factor), inputs: shape(inputs), convention: "W:[input,output], A:[input,rank], B:[rank,output], X:[sample,input]"}) } else { if (1 - u:is_finite_numeric(base)) + (1 - u:is_finite_numeric(left_factor)) + (1 - u:is_finite_numeric(right_factor)) + (1 - u:is_finite_numeric(inputs)) { err({kind: "lora_nonfinite"}) } else { if (1 - gt(left_dimensions.columns, 0)) + gt(left_dimensions.columns, base_dimensions.rows) + gt(left_dimensions.columns, base_dimensions.columns) { err({kind: "lora_rank", rank: left_dimensions.columns, maximum: if lt(base_dimensions.rows, base_dimensions.columns) { base_dimensions.rows } else { base_dimensions.columns }}) } else {
    delta = matmul(left_factor, right_factor); merged = base + delta; base_outputs = matmul(inputs, base); adapted_outputs = matmul(inputs, merged); output_delta = adapted_outputs - base_outputs; factorized_output_delta = matmul(matmul(inputs, left_factor), right_factor); base_parameters = base_dimensions.rows * base_dimensions.columns; adapter_parameters = left_dimensions.rows * left_dimensions.columns + right_dimensions.rows * right_dimensions.columns;
    ok({base: base, left_factor: left_factor, right_factor: right_factor, delta: delta, merged: merged, inputs: inputs, base_outputs: base_outputs, adapted_outputs: adapted_outputs, output_delta: output_delta, factorized_output_delta: factorized_output_delta, input_shape: shape(inputs), base_shape: shape(base), left_shape: shape(left_factor), right_shape: shape(right_factor), delta_shape: shape(delta), output_shape: shape(adapted_outputs), rank: left_dimensions.columns, base_parameters: base_parameters, adapter_parameters: adapter_parameters, parameter_savings: base_parameters - adapter_parameters, parameter_efficient: gt(base_parameters, adapter_parameters), mechanism: "W_plus_A_matmul_B", training_claim: 0, quality_claim: 0})
  } } }
}

def u:single_head_attention(queries, keys, values) { "Compute one unbatched scaled dot-product attention head with explicit rank-2 axes.";
  query_dimensions = u:matrix_dimensions(queries)?; key_dimensions = u:matrix_dimensions(keys)?; value_dimensions = u:matrix_dimensions(values)?; compatible = eq(query_dimensions.columns, key_dimensions.columns) * eq(key_dimensions.rows, value_dimensions.rows);
  if (1 - compatible) + (1 - gt(query_dimensions.columns, 0)) { err({kind: "attention_shape", queries: shape(queries), keys: shape(keys), values: shape(values), convention: "Q:[query,feature], K:[key,feature], V:[key,value]"}) } else { if (1 - u:is_finite_numeric(queries)) + (1 - u:is_finite_numeric(keys)) + (1 - u:is_finite_numeric(values)) { err({kind: "attention_nonfinite"}) } else {
    scale = sqrt(query_dimensions.columns); raw_scores = matmul(queries, transpose(keys)); scaled_scores = raw_scores / scale; weights = softmax(scaled_scores, 1); row_sums = reduce_add(weights, 1); output = matmul(weights, values);
    ok({queries: queries, keys: keys, values: values, raw_scores: raw_scores, scale: scale, scaled_scores: scaled_scores, weights: weights, weight_row_sums: row_sums, output: output, query_shape: shape(queries), key_shape: shape(keys), value_shape: shape(values), score_shape: shape(scaled_scores), weight_shape: shape(weights), output_shape: shape(output), axes: {queries: "query,feature", keys: "key,feature", scores: "query,key", values: "key,value", output: "query,value"}, heads: 1, batched: 0, blocker: "B1_higher_rank_matmul"})
  } }
}
