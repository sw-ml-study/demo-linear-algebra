# LA12 bounded pedagogical Gaussian elimination.
include "lib/systems.mlpl";

@test {name: "elimination swaps away a zero first pivot", tags: ["LA12", "elimination", "pivot"]}
def u:test_elimination_row_swap() { "Trace a required row swap through exact RREF.";
  trace = u:eliminate_system2([[0, 2], [1, 1]], [4, 3], 0.000000001)?;
  u:assert_eq(trace.kind, "unique", "classification")?; u:assert_eq(trace.swapped, 1, "swap decision")?; u:assert_eq(trace.pivoted, [[1, 1, 3], [0, 2, 4]], "pivoted matrix")?; u:assert_eq(trace.rref, [[1, 0, 1], [0, 1, 2]], "rref")?; u:assert_eq(trace.candidate, [1, 2], "candidate")?; u:assert_eq(trace.residual_norm, 0, "residual")
}

@test {name: "elimination records a nonzero row multiplier", tags: ["LA12", "elimination", "trace"]}
def u:test_elimination_multiplier() { "Expose R2 <- R2-m R1 for a unique fixture.";
  trace = u:eliminate_system2([[2, 1], [4, 3]], [4, 10], 0)?;
  u:assert_eq(trace.swapped, 0, "unexpected swap")?; u:assert_eq(trace.multiplier, 2, "multiplier")?; u:assert_eq(trace.echelon, [[2, 1, 4], [0, 1, 2]], "echelon")?; u:assert_eq(trace.candidate, [1, 2], "candidate")
}

@test {name: "rank pairs distinguish inconsistent and underdetermined", tags: ["LA12", "rank"]}
def u:test_elimination_rank_classification() { "Compare coefficient and augmented ranks on singular fixtures.";
  inconsistent = u:eliminate_system2([[1, 1], [2, 2]], [2, 5], 0.000000001)?; under = u:eliminate_system2([[1, 1], [2, 2]], [2, 4], 0.000000001)?;
  u:assert_eq(inconsistent.kind, "parallel_inconsistent", "inconsistent kind")?; u:assert_eq([inconsistent.coefficient_rank, inconsistent.augmented_rank], [1, 2], "inconsistent ranks")?; u:assert_eq(under.kind, "coincident_underdetermined", "underdetermined kind")?; u:assert_eq([under.coefficient_rank, under.augmented_rank], [1, 1], "underdetermined ranks")
}

@test {name: "zero system ranks remain zero unless target contradicts", tags: ["LA12", "rank", "degenerate"]}
def u:test_elimination_zero_rank() { "Pin rank zero consistent and augmented-rank one inconsistent cases.";
  consistent = u:eliminate_system2([[0, 0], [0, 0]], [0, 0], 0)?; inconsistent = u:eliminate_system2([[0, 0], [0, 0]], [0, 1], 0)?;
  u:assert_eq([consistent.coefficient_rank, consistent.augmented_rank], [0, 0], "zero ranks")?; u:assert_eq([inconsistent.coefficient_rank, inconsistent.augmented_rank], [0, 1], "zero contradiction ranks")
}

@test {name: "elimination advertises and enforces its 2x2 limit", tags: ["LA12", "errors"]}
def u:test_elimination_size_boundary() { "Reject other sizes, bad targets, tolerance, and non-finite data.";
  u:assert_true(is_err(u:eliminate_system2(reshape(range(9), [3, 3]), [1, 2, 3], 0)), "3x3 accepted")?; u:assert_true(is_err(u:eliminate_system2([[1, 0], [0, 1]], [1], 0)), "short target accepted")?; u:assert_true(is_err(u:eliminate_system2([[1, 0], [0, 1]], [1, 2], -0.1)), "negative tolerance accepted")?; u:assert_true(is_err(u:eliminate_system2([[1, 0], [0, 1 / 0]], [1, 2], 0)), "infinity accepted")
}

u:run_registered_tests()
