# Fixed-fixture SVG evidence for LA12. Rendering is infrastructure.
# loops: 0

def u:elimination_svg() { "Render a pivot swap and row elimination alongside rank outcomes.";
  "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 980 470\" width=\"980\" height=\"470\" role=\"img\"><title>Bounded Gaussian elimination exposes pivots and rank</title><desc>A two-by-three augmented matrix swaps rows to obtain a nonzero first pivot, eliminates below it, and reaches reduced row echelon form. Smaller panels compare unique, inconsistent, and underdetermined rank pairs.</desc><style>text{font-family:monospace;fill:#c0caf5}.p{fill:#24283b;stroke:#414868;stroke-width:2}.m{fill:#1a1b26;stroke:#565f89}.pivot{fill:#e0af68}.zero{fill:#9ece6a}.bad{fill:#f7768e}.arrow{fill:#7aa2f7;font-size:24px}</style><rect width=\"980\" height=\"470\" fill=\"#1a1b26\"/><text x=\"30\" y=\"32\" font-size=\"20\">2x2 teaching limit: swap, eliminate, classify rank(A) versus rank([A|b])</text><rect class=\"p\" x=\"20\" y=\"60\" width=\"285\" height=\"220\" rx=\"14\"/><text x=\"40\" y=\"92\">INITIAL [A|b]</text><text x=\"65\" y=\"145\">[ 0  2 | 4 ]</text><text x=\"65\" y=\"190\">[ 1  1 | 3 ]</text><text class=\"pivot\" x=\"50\" y=\"245\">zero pivot: swap R1,R2</text><text class=\"arrow\" x=\"315\" y=\"175\">→</text><rect class=\"p\" x=\"355\" y=\"60\" width=\"285\" height=\"220\" rx=\"14\"/><text x=\"375\" y=\"92\">PIVOTED / ECHELON</text><text x=\"400\" y=\"145\">[ 1  1 | 3 ]</text><text x=\"400\" y=\"190\">[ 0  2 | 4 ]</text><text class=\"zero\" x=\"385\" y=\"245\">multiplier=0; pivots 1,2</text><text class=\"arrow\" x=\"650\" y=\"175\">→</text><rect class=\"p\" x=\"690\" y=\"60\" width=\"270\" height=\"220\" rx=\"14\"/><text x=\"710\" y=\"92\">RREF / SOLUTION</text><text x=\"735\" y=\"145\">[ 1  0 | 1 ]</text><text x=\"735\" y=\"190\">[ 0  1 | 2 ]</text><text class=\"zero\" x=\"725\" y=\"245\">x=[1,2], residual=0</text><rect class=\"p\" x=\"20\" y=\"315\" width=\"940\" height=\"110\" rx=\"14\"/><text x=\"70\" y=\"350\">UNIQUE</text><text x=\"55\" y=\"390\">rank A=2, rank [A|b]=2</text><text class=\"bad\" x=\"390\" y=\"350\">INCONSISTENT</text><text x=\"375\" y=\"390\">rank A=1, rank [A|b]=2</text><text class=\"pivot\" x=\"735\" y=\"350\">UNDERDETERMINED</text><text x=\"720\" y=\"390\">rank A=1, rank [A|b]=1</text><text x=\"490\" y=\"455\" text-anchor=\"middle\">Every division follows an explicit |pivot| &gt; tolerance guard</text></svg>"
}
