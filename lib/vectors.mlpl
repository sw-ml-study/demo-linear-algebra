# Pure rank-1 vector operations for the introductory curriculum.
# loops: 0

def u:is_vector(value) { "Return one exactly when value has rank one."; eq(rank(value), 1) }
def u:same_vector_shape(left, right) { "Check that two rank-one arrays have the same shape.";
  u:is_vector(left) * u:is_vector(right) * equal(shape(left), shape(right))
}
def u:vector_add(left, right) { "Add corresponding vector components or return a shape error.";
  if u:same_vector_shape(left, right) { ok(left + right) } else { err({kind: "vector_shape", left: shape(left), right: shape(right)}) }
}
def u:vector_scale(scalar, vector) { "Scale every component of a rank-one vector.";
  if u:is_vector(vector) { ok(scalar * vector) } else { err({kind: "vector_rank", actual: rank(vector), expected: 1}) }
}
def u:zero_vector_like(vector) { "Construct the additive identity with the vector's shape.";
  if u:is_vector(vector) { ok(fill(shape(vector), 0)) } else { err({kind: "vector_rank", actual: rank(vector), expected: 1}) }
}
def u:vector_dot(left, right) { "Derive the dot product by multiplying matching components and reducing their sum.";
  if u:same_vector_shape(left, right) { ok(reduce_add(left * right)) } else { err({kind: "vector_shape", left: shape(left), right: shape(right)}) }
}
def u:alignment_kind(left, right) { "Classify the sign of a valid dot product as aligned, orthogonal, or opposed.";
  score = u:vector_dot(left, right)?;
  if gt(score, 0) { ok("aligned") } else { if lt(score, 0) { ok("opposed") } else { ok("orthogonal") } }
}
def u:vector_norm(vector) { "Compute Euclidean length as the square root of the vector's self-dot.";
  if u:is_vector(vector) { ok(sqrt(u:vector_dot(vector, vector)?)) } else { err({kind: "vector_rank", actual: rank(vector), expected: 1}) }
}
def u:vector_distance(left, right) { "Compute Euclidean distance as the norm of the componentwise difference.";
  if u:same_vector_shape(left, right) { u:vector_norm(left - right) } else { err({kind: "vector_shape", left: shape(left), right: shape(right)}) }
}
def u:vector_normalize(vector) { "Return a unit vector, rejecting the zero vector because its direction is undefined.";
  length = u:vector_norm(vector)?;
  if eq(length, 0) { err({kind: "zero_norm", message: "the zero vector has no direction"}) } else { ok(vector / length) }
}
